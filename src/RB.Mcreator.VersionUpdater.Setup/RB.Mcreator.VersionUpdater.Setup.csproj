<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RB-All-Updater-Setup</AssemblyName>
    <RootNamespace>RB.Mcreator.VersionUpdater.Setup</RootNamespace>
    <Product>RB All Updater Setup</Product>
    <Company>RobbieB1980</Company>
    <Version>1.3.1</Version>
    <FileVersion>1.3.1</FileVersion>
    <Description>Installer for RB All Updater (portable toolset)</Description>
  </PropertyGroup>

  <!-- Built by scripts/Build-Release.ps1 before publish -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\portable-payload.zip"
                      Condition="Exists('..\..\dist\portable-payload.zip')"
                      LogicalName="portable-payload.zip" />
  </ItemGroup>

</Project>
